{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LynxPath Reproducible Demo Scenario",
  "type": "object",
  "required": [
    "scenario_version",
    "id",
    "title",
    "description",
    "steps"
  ],
  "properties": {
    "scenario_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "snapshot"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "event": {
            "type": "string"
          },
          "snapshot": {
            "$ref": "capacity-snapshot.schema.json"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
